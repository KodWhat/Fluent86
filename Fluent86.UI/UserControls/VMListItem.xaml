<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluent86.UI.UserControls.VMListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluent86.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
	xmlns:corevm="using:Fluent86.Core.VirtualMachines"
	xmlns:mkext="using:Fluent86.UI.MarkupExtensions"
	xmlns:converters="using:Fluent86.UI.Converters"
	d:DataContext="{d:DesignInstance Type=corevm:VirtualMachineInfo}">
	<UserControl.Resources>
		<converters:VMStatusToBrushConverter 
			x:Key="VMStatusToBrushConverter" 
			StoppedBrush="{StaticResource VMStatusStoppedBrush}"
			RunningBrush="{StaticResource VMStatusRunningBrush}"
			PausedBrush="{StaticResource VMStatusPausedBrush}"
			WaitingBrush="{StaticResource VMStatusPausedBrush}"/>
	</UserControl.Resources>
	<Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
		<Expander.Header>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<FontIcon Grid.Column="0" Glyph="&#xEA6C;" Foreground="{Binding Status, Converter={StaticResource VMStatusToBrushConverter}}"/>

				<TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8, 0, 0, 0" VerticalAlignment="Center"/>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
					<Button>
						<FontIcon Glyph="&#xE768;"/>
					</Button>
					<Button>
						<FontIcon Glyph="&#xE713;"/>
					</Button>
				</StackPanel>
			</Grid>
		</Expander.Header>
		<Expander.Content>
			<StackPanel>
				<TextBlock>
					<TextBlock.Inlines>
						<Run Text="{mkext:Localization Name=VmInfoPathLabel}" FontWeight="Bold"/>
						<Run Text="{Binding Path}"/>
					</TextBlock.Inlines>
				</TextBlock>
				<TextBlock>
					<TextBlock.Inlines>
						<Run Text="{mkext:Localization Name=VmInfoDescriptionLabel}" FontWeight="Bold"/>
						<Run Text="{Binding Description}"/>
					</TextBlock.Inlines>
				</TextBlock>
			</StackPanel>
		</Expander.Content>
	</Expander>
</UserControl>