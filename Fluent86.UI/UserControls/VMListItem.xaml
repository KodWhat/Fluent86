<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluent86.UI.UserControls.VMListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluent86.UI.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
	xmlns:corevm="using:Fluent86.Core.VirtualMachines"
	xmlns:mkext="using:Fluent86.UI.MarkupExtensions"
	xmlns:converters="using:Fluent86.UI.Converters"
	xmlns:commuConverters="using:CommunityToolkit.WinUI.Converters"
	xmlns:commuControls="using:CommunityToolkit.WinUI.Controls"
	d:DataContext="{d:DesignInstance Type=corevm:VirtualMachineInfo}">
	<UserControl.Resources>
		<converters:VMStatusToBrushConverter 
			x:Key="VMStatusToBrushConverter" 
			StoppedBrush="{StaticResource VMStatusStoppedBrush}"
			RunningBrush="{StaticResource VMStatusRunningBrush}"
			PausedBrush="{StaticResource VMStatusPausedBrush}"
			WaitingBrush="{StaticResource VMStatusPausedBrush}"/>

		<commuConverters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
	</UserControl.Resources>
	<commuControls:SettingsExpander 
		HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
		Header="{Binding Name}"
		Description="{Binding Description}">
		<commuControls:SettingsExpander.HeaderIcon>
			<FontIcon Glyph="&#xEA6C;" Foreground="{Binding Status, Converter={StaticResource VMStatusToBrushConverter}}"/>
		</commuControls:SettingsExpander.HeaderIcon>
		<commuControls:SettingsExpander.Content>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button x:Name="StartVM" Click="StartVM_Click">
					<FontIcon Glyph="&#xE768;"/>
				</Button>
				<Button Background="Transparent" BorderBrush="Transparent">
					<Button.Content>
						<FontIcon Glyph="&#xE712;"/>
					</Button.Content>
					<Button.Flyout>
						<MenuFlyout Placement="Bottom">
							<MenuFlyoutItem Text="Edit">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE70F;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Text="Configure">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE713;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem Text="Delete" Foreground="{StaticResource SystemFillColorCriticalBrush}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" Foreground="{StaticResource SystemFillColorCriticalBrush}"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</commuControls:SettingsExpander.Content>
		<commuControls:SettingsExpander.Items>
			<commuControls:SettingsCard ContentAlignment="Left">
				<StackPanel>
					<TextBlock>
						<TextBlock.Inlines>
							<Run Text="{mkext:Localization Name=VmInfoPathLabel}" FontWeight="Bold"/>
							<Run Text="{Binding Path}"/>
						</TextBlock.Inlines>
					</TextBlock>
				</StackPanel>
			</commuControls:SettingsCard>
		</commuControls:SettingsExpander.Items>
	</commuControls:SettingsExpander>
</UserControl>